# ── WorldOps AI server-only configuration ────────────────────────────────
# Never expose these values to the browser. The app has no NEXT_PUBLIC_ LLM keys.
#
# Leave LLM_API_KEY empty to run the deterministic local demo.
# Any OpenAI-compatible Chat Completions endpoint works. The current demo uses
# OpenCode Go with DeepSeek V4.1 Flash.
LLM_API_KEY=
LLM_BASE_URL=https://opencode.ai/inference/go/openai/v1
LLM_MODEL=deepseek-v4.1-flash
# OpenCode Go / DeepSeek: disable hidden reasoning so the JSON plan is complete.
LLM_DISABLE_REASONING=true
